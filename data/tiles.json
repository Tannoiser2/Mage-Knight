{
 "_notes": {
  "dirs": "Chiavi degli esagoni: center=(0,0), \"0\"=W(-1,0), \"60\"=SW(-1,+1), \"120\"=SE(0,+1), \"180\"=E(+1,0), \"240\"=NE(+1,-1), \"300\"=NW(0,-1) (assiali, punta in alto). Verificato su tessere A, 2 e 12.",
  "texture": "Tutte le texture sono 2048x1970 px; centro dell'esagono centrale = [1024.0, 985.0] px, raggio esagono (centro-vertice) = 394 px; vicini a ±√3·r in x e ±1.5·r in y. Le texture sono copiate senza ridimensionare.",
  "texture_px": {
   "w": 2048,
   "h": 1970,
   "center": [
    1024.0,
    985.0
   ],
   "hex_radius": 394.0
  },
  "sites": "orcs = Orchi Predoni (nemico verde infuriato), draconum = Draconum (nemico rosso infuriato), ruins = Antiche Rovine (segnalino giallo), keep = Castello, mage_tower = Torre della Magia, dungeon = Sotterraneo, tomb = Tomba, monster_den = Tana del Mostro, spawning_grounds = Terreni di Nidificazione, glade = Radura Magica, mine = Miniera di Cristallo (colore in \"mine\"), camp = Campo Profughi (LL), maze/labyrinth = Dedalo/Labirinto (LL), oasis/pyramid/ziggurat (Apocalypse Dragon).",
  "mines": "mines: {dir: colore} (stringa); nelle tessere di espansione una miniera può produrre più colori a scelta (Miniere Profonde) e allora il valore è un array.",
  "walls": "walls (solo espansioni): per ogni esagono, l'elenco dei lati (direzioni) con un muro.",
  "sets": "base = gioco base (Campagna 1-11, Centrali 1-4, Città 5-8, iniziali A/B); ll = Lost Legion (Campagna 12-14, Centrali 9-10, campo di Volkare); apocalypse = Apocalypse Dragon (Campagna 15-17, Centrali 11-12). Fonte: setupContentRoster del Lua.",
  "kinds": "start | country | core | city (k05..k08 sono le tessere città: verde, blu, bianca, rossa).",
  "terrain": "plains pianura, hills colline, forest foresta, wasteland terre perdute (landa), desert deserto, swamp palude, lake lago, mountain montagna, ocean oceano."
 },
